title: "Prey Energy Contribution Calculator (PECC)"
type: software
version: "1.0.0"
date-released: 2026-09-07
authors:
  - family-names: "Son"
    given-names: "Joon-Young"
    orcid: "https://orcid.org/0009-0004-0145-1468"
